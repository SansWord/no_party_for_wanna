{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-party-leaderboard",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "no-party-leaderboard",
      // Replace with the id printed by `npx wrangler d1 create no-party-leaderboard`.
      "database_id": "9bcba9b8-a661-40f6-8169-6d5447161b1d"
    }
  ],
  // Per-IP limit on starting runs (hashed IP as key). Replaces the old runs-table COUNT.
  "ratelimits": [
    { "name": "START_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // Comma-separated browser origins allowed to call the API.
    "ALLOWED_ORIGINS": "https://sansword.github.io,http://localhost:8080"
  }
  // Secrets: `npx wrangler secret put RUN_SECRET` (required: signs run tokens) and
  // `npx wrangler secret put IP_SALT` (salts the hashed IPs used as rate-limit keys).
}
